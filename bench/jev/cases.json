    { "id": "J05", "kind": "single", "lang": "en", "request": "list the spreadsheets in my Drive", "required": [["sheets_list_spreadsheets", "drive_search_files"]], "forbidden": ["drive_delete_file", "sheets_create_spreadsheet"] },
    { "id": "J06", "kind": "single", "lang": "en", "request": "read A1:F50 from the budget spreadsheet", "required": [["sheets_read_range", "sheets_batch_read_ranges"]], "forbidden": ["sheets_write_range", "sheets_clear_range"] },
