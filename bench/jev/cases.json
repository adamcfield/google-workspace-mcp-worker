    { "id": "J08", "kind": "single", "lang": "en", "request": "find the slide deck named Q3 review", "required": [["drive_search_files"]], "forbidden": ["drive_delete_file", "slides_delete_object"] },
    { "id": "J09", "kind": "single", "lang": "en", "request": "what tasks do I have open", "required": [["tasks_list_tasks"]], "forbidden": ["tasks_delete_task", "tasks_clear_completed_tasks"] },
    { "id": "J10", "kind": "single", "lang": "en", "request": "which Google account am I signed in as", "required": [["google_whoami"]], "forbidden": [] },
    { "id": "J11", "kind": "single", "lang": "en", "request": "get the phone number for the contact named Jordan Lee", "required": [["contacts_search_contacts", "contacts_get_contact"]], "forbidden": ["contacts_delete_contact", "contacts_update_contact"] },
