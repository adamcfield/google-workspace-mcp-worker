    { "id": "J39", "kind": "multi", "lang": "en", "request": "find last week's expense rows and clear them out", "required": [["sheets_read_range", "sheets_batch_read_ranges"], ["sheets_clear_range"]], "forbidden": ["sheets_delete_sheet"] },
