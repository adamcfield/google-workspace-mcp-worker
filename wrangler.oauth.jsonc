{
  // OAUTH deployment (src/oauth.ts) — the claude.ai custom connector (web, desktop,
  // mobile) and any OAuth-capable MCP client. PRIMARY deployment.
  //
  // Deploy with:  npx wrangler deploy -c wrangler.oauth.jsonc
  // One-time setup (scripts/setup.sh does all of it):
  //   npx wrangler kv namespace create OAUTH_KV                          -> paste the id below
  //   npx wrangler secret put GOOGLE_CLIENT_ID     -c wrangler.oauth.jsonc
  //   npx wrangler secret put GOOGLE_CLIENT_SECRET -c wrangler.oauth.jsonc
  // The Google OAuth client must list https://google-workspace-mcp-oauth.<sub>.workers.dev/callback
  // as an authorized redirect URI.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "google-workspace-mcp-oauth",
  "main": "src/oauth.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "MCP_OBJECT", "class_name": "GoogleWorkspaceMCP" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GoogleWorkspaceMCP"] }],
  "kv_namespaces": [
    // OAuth provider state (clients, grants with ENCRYPTED props holding each user's
    // Google refresh token, MCP tokens), short-lived login state, encrypted token cache.
    // Run `npx wrangler kv namespace create OAUTH_KV` and paste the id it prints.
    // A KV namespace may be shared with other Workers: every key this code writes is
    // prefixed `gws:`, so it cannot collide with a sibling's.
    { "binding": "OAUTH_KV", "id": "REPLACE_WITH_YOUR_OAUTH_KV_ID" }
  ],
  "vars": {
    // Restrict sign-in to these Google accounts (comma-separated emails and/or @domains).
    // Empty = anyone who can pass Google's consent screen for your OAuth client. Set it.
    // Fail closed: with an empty allow-list NOBODY can sign in unless ALLOW_ANY_GOOGLE_ACCOUNT is "true".
    "ALLOWED_EMAILS": "you@example.com",
    "ALLOW_ANY_GOOGLE_ACCOUNT": "false",
    // Optional: pre-select a Workspace domain on Google's account chooser (hd). Enforcement stays ALLOWED_EMAILS.
    "GOOGLE_HOSTED_DOMAIN": "",
    // Least privilege: comma-separated product groups to expose (empty = all). Only their Google scopes are
    // requested at consent, so users see a shorter permission screen. Keys: sheets, drive, docs, gmail, calendar,
    // tasks, contacts, chat, slides, forms, photos, youtube, meet. Users must reconnect after changing these.
    // Profile shorthands are also accepted: core, gmail, calendar, drive_docs, personal, sheets_power_user,
    // company_admin. A GROUP name always wins over a profile of the same name, so pre-1.5 values are unchanged.
    "ENABLED_TOOL_GROUPS": "",
    "DISABLED_TOOL_GROUPS": "",
    // Which tools are ADVERTISED in tools/list. LEFT UNSET ON PURPOSE = "full" = today's behaviour:
    // every enabled tool is listed. "compact" advertises a small recipe set instead; everything else
    // stays registered and callable by name, so a cached claude.ai connector keeps working.
    // PR-11 flips the default to "compact" — set it explicitly here to pin either mode across that change.
    //   "TOOL_SURFACE": "compact",
    // Comma/space-separated extra tool names to advertise on top of a compact surface. It changes
    // nothing while TOOL_SURFACE is "full", but a name this deployment does not have is still
    // reported in /health warnings there, so a typo shows up before you switch to compact.
    //   "TOOL_SURFACE_ADD": "gmail_send_message, drive_create_file",
    // Per-MCP-session tool-call budget (calls/minute; "0" = unlimited).
    "TOOL_RATE_LIMIT_PER_MIN": "120",
    "MCP_READONLY": "false"
  },
  "observability": { "enabled": true },
  // Source maps make Workers Logs stack traces point at src/*.ts instead of the bundle.
  "upload_source_maps": true,
  // Per-IP limit on the unauthenticated auth surface (/authorize, /callback, /register, /token).
  "ratelimits": [{ "name": "AUTH_RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }]
}
