{
  "name": "google-workspace-mcp",
  "version": "1.6.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "Remote MCP server on Cloudflare Workers giving Claude full read/write access to a Google Workspace account via Google OAuth (Sheets, Drive, Docs, Gmail, Calendar, Tasks, Contacts, Chat, Slides, Forms, Photos, YouTube, Meet).",
  "scripts": {
    "dev": "wrangler dev",
    "dev:oauth": "wrangler dev -c wrangler.oauth.jsonc --port 8788",
    "deploy": "wrangler deploy",
    "deploy:oauth": "wrangler deploy -c wrangler.oauth.jsonc",
    "deploy:all": "wrangler deploy && wrangler deploy -c wrangler.oauth.jsonc",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "tools:md": "node scripts/gen-tools-md.mjs",
    "gen": "node scripts/gen-tools-md.mjs && node scripts/measure-tools.mjs --current",
    "gen:check": "node scripts/gen-tools-md.mjs --check && node scripts/measure-tools.mjs --check",
    "measure": "node scripts/measure-tools.mjs",
    "tool-usage": "node scripts/tool-usage.mjs",
    "bench:fixtures": "node bench/fixtures.mjs",
    "bench:run": "node scripts/bench-run.mjs",
    "bench:score": "node bench/score.mjs",
    "jev:bench": "node scripts/jev-bench.mjs",
    "jev:live": "node scripts/jev-bench.mjs --live",
    "cf-typegen": "wrangler types",
    "tail": "wrangler tail",
    "tail:oauth": "wrangler tail -c wrangler.oauth.jsonc"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.0.0",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "agents": "0.24.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@anthropic-ai/tokenizer": "^0.0.4",
    "@cloudflare/workers-types": "^5.20260917.1",
    "@types/node": "^22.20.3",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "wrangler": "^4.138.0",
    "yaml": "^2.9.1"
  }
}
