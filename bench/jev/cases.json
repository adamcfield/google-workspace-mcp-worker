    { "id": "J15", "kind": "single", "lang": "he", "request": "מה יש לי ביומן מחר", "required": [["calendar_list_events"]], "forbidden": ["calendar_create_event", "calendar_delete_event"] },
    { "id": "J16", "kind": "single", "lang": "he", "request": "חפש את המיילים מרואה החשבון", "required": [["gmail_search_messages"]], "forbidden": ["gmail_send_message", "gmail_trash_message"] },
    { "id": "J17", "kind": "single", "lang": "he", "request": "תקרא לי את התוכן של המסמך", "required": [["docs_read_document"]], "forbidden": ["docs_delete_range", "docs_replace_text"] },
