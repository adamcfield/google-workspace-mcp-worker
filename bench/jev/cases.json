{
  "$comment": "Labeled routing benchmark for the JEV tool-selection workstream. Hand-written, no generated content. Each case states the request a user might make and which tools a correct selector must expose the schema for. `required` is a list of SLOTS; each slot is a list of interchangeable tools, and the slot counts as recalled when the selector picks at least one of them. `forbidden` lists tools the selector must never pick for this request — this is where an over-eager selector that reaches for an irreversible action gets caught. All names, addresses and domains are fictional (example.com).",
  "schemaVersion": 1,
  "cases": [
    { "id": "J01", "kind": "single", "lang": "en", "request": "find the emails from the supplier about invoice 4471", "required": [["gmail_search_messages"]], "forbidden": ["gmail_send_message", "gmail_trash_message"] },
    { "id": "J02", "kind": "single", "lang": "en", "request": "open that message and show me the full body", "required": [["gmail_read_message"]], "forbidden": ["gmail_send_message", "gmail_trash_message"] },
    { "id": "J03", "kind": "single", "lang": "en", "request": "what is on my calendar tomorrow", "required": [["calendar_list_events"]], "forbidden": ["calendar_create_event", "calendar_delete_event"] },
