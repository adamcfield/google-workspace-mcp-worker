    { "id": "J33", "kind": "multi", "lang": "en", "request": "take the form responses and put them into a new spreadsheet", "required": [["forms_list_responses"], ["sheets_create_spreadsheet"]], "forbidden": ["forms_delete_item"] },
    { "id": "J34", "kind": "multi", "lang": "en", "request": "read the document and create a task for each action item in it", "required": [["docs_read_document"], ["tasks_create_task"]], "forbidden": ["docs_delete_range", "tasks_delete_task"] },
    { "id": "J35", "kind": "multi", "lang": "he", "request": "תבדוק אם אני פנוי ביום רביעי ותקבע פגישה", "required": [["calendar_get_free_busy", "calendar_list_events"], ["calendar_create_event", "calendar_quick_add_event"]], "forbidden": ["calendar_delete_event"] },
    { "id": "J36", "kind": "multi", "lang": "he", "request": "תמצא את הקובץ ותשתף אותו עם הצוות", "required": [["drive_search_files"], ["drive_share_file"]], "forbidden": ["drive_delete_file", "drive_delete_permission"] },
    { "id": "J37", "kind": "multi", "lang": "en", "request": "search Drive for the contract and export it as a PDF", "required": [["drive_search_files"], ["docs_export_document", "drive_read_file"]], "forbidden": ["drive_delete_file"] },
